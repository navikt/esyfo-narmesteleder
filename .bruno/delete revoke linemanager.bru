meta {
  name: delete revoke linemanager
  type: http
  seq: 11
}

delete {
  url: {{baseUrlIntern}}/internal/api/v1/linemanager/:id
  body: json
  auth: inherit
}

params:path {
  id: {{narmesteLederId}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const http = require("axios");
  if (bru.getEnvName() === "nl_vars_local" && !bru.hasEnvVar("token")) {
    throw new Error("Kjør request 'mock-auth/tokenx/create tokenx' først for å teste lokalt");
  } else {
    const systembrukerOrgnr = bru.getEnvVar("systemKundeOrgnr");
    const tokenrespons = await http.get("https://esyfo-token.intern.dev.nav.no/systembruker/" + systembrukerOrgnr + "?scope=nav%3Asyfo%2Fnarmesteleder%2Flps");
    req.setHeader("Authorization", "Bearer "+ tokenrespons.data);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Lokalt: start avhengighetene med `mise docker-up` og applikasjonen med `mise start`.
  Før du kjører dette kallet, må du kjøre `mock-auth/tokenx/create tokenx` for å hente et TokenX-token.
}
